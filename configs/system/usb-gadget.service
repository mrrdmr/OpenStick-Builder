[Unit]
Description=Load USB gadget scheme (CDC-NCM)
Requires=sys-kernel-config.mount
After=sys-kernel-config.mount systemd-udev-settle.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/usr/sbin/modprobe libcomposite
ExecStartPre=-/usr/sbin/modprobe usb_f_ncm
ExecStart=/usr/bin/gt load ncm.scheme usb0
ExecStop=/usr/bin/gt rm -rf usb0

[Install]
WantedBy=multi-user.target
